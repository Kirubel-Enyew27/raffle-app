# Copy to backend/.env and fill in the values. backend/.env is gitignored:
# never commit real keys.
#
# Values here are loaded by the Go server itself (pkg/config reads .env when it
# is present) and injected into the docker compose backend service via
# `env_file`. Real environment variables always take precedence over this file.

# --- App ---
APP_ENV=development
APP_PORT=8080
APP_DEBUG=true

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=raffle
DB_PASSWORD=raffle_dev
DB_NAME=raffle_db
DB_SSL_MODE=disable

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Auth ---
JWT_SECRET=change-me-in-production
# Access tokens are short lived; clients renew them with JWT_REFRESH_EXPIRY-long
# refresh tokens, so an active match is never interrupted by a token expiring.
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# --- Sign in with Google (optional) ---
# Leave these empty to disable the feature: the login page hides the button and
# the API reports Google sign-in as unavailable. Create the credentials at
# https://console.cloud.google.com/apis/credentials (OAuth client type: Web
# application) and see docs/GOOGLE_SIGN_IN.md for the full console checklist.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an "Authorized redirect URI" exactly, e.g.
#   local dev : http://localhost:8080/api/v1/auth/google/callback
#   production: https://<api-host>/api/v1/auth/google/callback
GOOGLE_REDIRECT_URL=
# Origin the browser is returned to after the callback.
FRONTEND_URL=http://localhost:5173

# --- Receipt verification / deposits ---
# GEMINI_API_KEY powers screenshot OCR for deposit receipts. Without it the
# upload box cannot read a Telebirr receipt at all (CBE can still fall back to
# decoding the QR code), and users must type the transaction number instead.
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# TELE_VERIFY_KEY enables the Telebirr proxy API. Without it verification falls
# back to scraping the public receipt page, which is slower and more fragile.
TELE_VERIFY_KEY=
TELE_VERIFY_URL=https://verifyapi.leulzenebe.pro/verify-telebirr

# --- Bank / wallet account details shown on the deposit screen ---
CBE_RECEIPT_API=https://mb.cbe.com.et/api/v1/transactions/public/transaction-detail
CBE_APP_ID=
CBE_APP_VERSION=
CBE_ACCOUNT_NAME=
CBE_ACCOUNT_NUMBER=
TELEBIRR_ACCOUNT_NAME=
TELEBIRR_PHONE=
AUTO_CREDIT_ENABLED=true

# --- P2P Compete to Earn ---
# Deployment-level kill switch. Paid play is enabled by default; set this to
# false to turn staking off for the whole deployment. Wallet balance, stake
# limits, fee calculation and settlement checks always remain enforced.
PAID_MATCHES_ENABLED=true
# Platform commission on the paid prize pool, as a fraction (0.05 = 5%).
SERVICE_FEE_FACTOR=0.05

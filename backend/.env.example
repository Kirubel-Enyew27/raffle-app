# Copy to backend/.env and fill in the values. backend/.env is gitignored:
# never commit real keys.
#
# Values here are loaded by the Go server itself (pkg/config reads .env when it
# is present) and injected into the docker compose backend service via
# `env_file`. Real environment variables always take precedence over this file.

# --- App ---
APP_ENV=development
APP_PORT=8080
APP_DEBUG=true

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=raffle
DB_PASSWORD=raffle_dev
DB_NAME=raffle_db
DB_SSL_MODE=disable

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRY=15m

# --- Receipt verification / deposits ---
# GEMINI_API_KEY powers screenshot OCR for deposit receipts. Without it the
# upload box cannot read a Telebirr receipt at all (CBE can still fall back to
# decoding the QR code), and users must type the transaction number instead.
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# TELE_VERIFY_KEY enables the Telebirr proxy API. Without it verification falls
# back to scraping the public receipt page, which is slower and more fragile.
TELE_VERIFY_KEY=
TELE_VERIFY_URL=https://verifyapi.leulzenebe.pro/verify-telebirr

# --- Bank / wallet account details shown on the deposit screen ---
CBE_RECEIPT_API=https://mb.cbe.com.et/api/v1/transactions/public/transaction-detail
CBE_APP_ID=
CBE_APP_VERSION=
CBE_ACCOUNT_NAME=
CBE_ACCOUNT_NUMBER=
TELEBIRR_ACCOUNT_NAME=
TELEBIRR_PHONE=
AUTO_CREDIT_ENABLED=true
